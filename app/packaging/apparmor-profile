abi <abi/4.0>,
include <tunables/global>

# The public launcher is a shell/Python ownership wrapper. Attach userns to the
# actual Electron image it executes, not to the wrapper's interpreter chain.
profile odin-desktop "/opt/Odin/odin-desktop.bin" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/odin-desktop>
}
