{
  "name": "odin-desktop",
  "productName": "Odin",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Calmingstorm/Odin-Desktop",
  "author": "Calmingstorm",
  "description": "Odin Desktop: the Odin execution agent as a desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:native-guards": "node --test scripts/native-p33-display.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "test:real-core": "node scripts/real-core-test.mjs && npm run test:onboarding",
    "test:onboarding": "electron-vite build && node scripts/onboarding-test.mjs",
    "smoke:real-core": "electron-vite build && node scripts/real-core-smoke.mjs",
    "test:a11y": "electron-vite build && node scripts/accessibility.mjs",
    "test:e2e": "electron-vite build && node scripts/lifecycle-e2e.mjs",
    "package:candidate": "node packaging/build-linux.mjs",
    "test:packaging": "python3 -m unittest discover -s packaging/tests -v"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "axe-core": "4.14.0",
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  }
}
